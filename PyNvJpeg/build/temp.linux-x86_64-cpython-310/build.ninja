ninja_required_version = 1.3
cxx = c++

cflags = -pthread -B /home/nkq/anaconda3/envs/yolo11/compiler_compat -Wno-unused-result -Wsign-compare -DNDEBUG -fwrapv -O2 -Wall -fPIC -O2 -isystem /home/nkq/anaconda3/envs/yolo11/include -fPIC -O2 -isystem /home/nkq/anaconda3/envs/yolo11/include -fPIC -I/home/nkq/anaconda3/envs/yolo11/lib/python3.10/site-packages/numpy/_core/include -I/home/nkq/anaconda3/envs/yolo11/lib/python3.10/site-packages/torch/include -I/home/nkq/anaconda3/envs/yolo11/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/home/nkq/anaconda3/envs/yolo11/lib/python3.10/site-packages/torch/include/TH -I/home/nkq/anaconda3/envs/yolo11/lib/python3.10/site-packages/torch/include/THC -I/home/nkq/anaconda3/envs/yolo11/include/python3.10 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=nvjpeg_wrapper -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++17
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc





build /home/nkq/yolov11-main/PyNvJpeg/build/temp.linux-x86_64-cpython-310/src/wrapper.o: compile /home/nkq/yolov11-main/PyNvJpeg/src/wrapper.cpp






